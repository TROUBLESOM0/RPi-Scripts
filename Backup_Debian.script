#!/bin/bash
#
# Creates backup of Debian system
#  Specifically on Raspberry Pi's running Raspberry Pi OS(Raspbian)

# Fail instantly
set -euo pipefail

### VARIABLES
Error='\033[1;31m'   # Bold red
Off='\033[0m'
USER=${SUDO_USER:-$USER}
THIS_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
HOSTNAME=$(hostname)
HOSTIP=$(hostname -I)
RELEASE=$(uname -r)
OS_BIT=$(uname -m)
OS_BIT_NUMBER=""
OS_NAME=$(cat /etc/os-release | grep VERSION_CODENAME | cut -d '=' -f2 | tr '[:lower:]' '[:upper:]')
MACHINE_BUILD=""
RAM_USAGE=$(free -h)
MANUAL_INSTALL_LIST=$(apt-mark showmanual | pr -t -3)
COMPLETE_INSTALL_LIST=$(dpkg-query -W -f='${Status}\t${Package}\t${Version}\t${binary:Summary}\n' | awk -F'\t' '$1 == "install ok installed" { printf "%-35s %-22s %s\n", $2, $3, $4 }')

DATE=$(date +"%m-%d-%Y")
BKUP_TEMP="/usr/bkup-temp"
BKUP="$BKUP_TEMP/${HOSTNAME}_${OS_NAME}-Bkup_${DATE}"
BKUP_FILE="$BKUP/contents.txt"
ZIP_FILE="$THIS_DIR/${HOSTNAME}_${OS_NAME}-Bkup_${DATE}.zip"

if [[ -f /proc/device-tree/model ]]; then
MACHINE_BUILD=$(tr -d '\0' < /proc/device-tree/model)
else MACHINE_BUILD=""
fi



##################
## BEGIN SCRIPT ##
##################
# Check script is running as root
if [[ $( whoami ) != "root" ]]
then echo -e "${Error}ERROR: Must be run as sudo or root ${Off}"
exit 1
fi

echo "User: $USER"
echo "Current Directory: $THIS_DIR"

# Determine 32 or 64 bit
if [[ $OS_BIT == "armv7l" || "armhf" ]]
then echo "32bit-OS"
OS_BIT_NUMBER="32bit"
else echo "64bit-OS"
OS_BIT_NUMBER="64bit"
fi

read -r -p "Do you want to create a backup?" input
if [[ "${input,,}" == "y" || "${input,,}" == "yes" ]]
then :
else exit 1
fi

##########################
##  CREATE BACKUP FILE ###
##########################
if [[ -d $BKUP_TEMP ]]
then rm -r $BKUP_TEMP
fi
mkdir -p $BKUP_TEMP
mkdir -p $BKUP
touch $BKUP_FILE
if [[ -f $BKUP_FILE ]]
then :
else echo -e "${Error}ERROR: Unable to create backup file: $BKUP_FILE ${Off}"
exit 1
fi

echo "Backup file created: $BKUP_FILE"
echo -e "\nCreating backup for:"
echo "- $HOSTNAME  $HOSTIP - $MACHINE_BUILD , $OS_BIT_NUMBER , $RELEASE"


# Check for rsync, will install if missing, and delete once complete.
if ! command -v rsync >/dev/null 2>&1
then echo "Installing rsync...will remove once complete"
echo "Installing RSYNC...will remove once complete" >> $BKUP_FILE
apt install rsync -y
REMOVE_RSYNC=1
fi
sleep 1


{
echo "Hostname: $HOSTNAME"
echo "Ip Address: $HOSTIP"
echo "$OS_BIT" + "$RELEASE"
echo "$MACHINE_BUILD"
echo "$OS_BIT_NUMBER"
echo -e "\n\n--- RAM USAGE ---"
echo "$RAM_USAGE"
echo -e "\n\n"
} >> $BKUP_FILE

echo "++++++++++++++++" >> $BKUP_FILE
echo "+   EXCLUDED   +" >> $BKUP_FILE
echo "++++++++++++++++" >> $BKUP_FILE
{
echo "- From Home Directory -"
echo "   -/.cache"
echo "   -/cache"
echo "   -/go/pkg"
echo "   -/whisper/venv"
} >> $BKUP_FILE


######################
##  BACKUP CRONJOBS ##
######################
mkdir -p "$BKUP/CRONJOBS"
echo -e "\nListing installed packages"
{
echo -e "\n\n--- LIST OF MANUALLY INSTALLED PACKAGES ---"
echo        "-------------------------------------------"
echo "$MANUAL_INSTALL_LIST"
} >> $BKUP_FILE

echo $MANUAL_INSTALL_LIST > "$BKUP/MANUAL-APT-LIST.txt"
echo $COMPLETE_INSTALL_LIST > "$BKUP/FULL-APT-LIST.txt"
echo -e "Packages listed in contents.txt\n"

echo -e "\n\nCRON JOBS:\n" >> $BKUP_FILE
echo -e "$USER - Cron List:" >> $BKUP_FILE
if
crontab -u $USER -l 2>/dev/null >> $BKUP_FILE
then echo "Copied crontab for $USER"
else echo "No crontab for $USER" && echo "No crontab for $USER" >> $BKUP_FILE
fi
echo -e "\nroot - Cron List:" >> $BKUP_FILE
if
crontab -u root -l 2>/dev/null >> $BKUP_FILE
then echo "Copied crontab for root"
else echo "No crontab for root" && echo "No crontab for root" >> $BKUP_FILE
fi
cp -rp "/etc/cron.d" "$BKUP/CRONJOBS" 2>/dev/null || true
cp -rp "/etc/cron.hourly" "$BKUP/CRONJOBS" 2>/dev/null || true
cp -rp "/etc/cron.daily" "$BKUP/CRONJOBS" 2>/dev/null || true
cp -rp "/etc/cron.weekly" "$BKUP/CRONJOBS" 2>/dev/null || true
cp -rp "/etc/cron.monthly" "$BKUP/CRONJOBS" 2>/dev/null || true
cp -rp "/etc/cron.yearly" "$BKUP/CRONJOBS" 2>/dev/null || true
echo "Copied cronjobs"
echo -e "\nCopied cronjobs" >> $BKUP_FILE


##################
##  BACKUP APT  ##
##################
if [[ -f /etc/apt/sources.list ]]
then
cp -rp /etc/apt/sources.list /etc/apt/sources.list.d "$BKUP/apt/" 2>/dev/null || true
echo "Copied apt sources" && echo "Copied apt sources" >> $BKUP_FILE
else echo -e "${Error}ERROR: APT Sources Doesn't exist ${Off}"
fi

if [[ -d /etc/apt/trusted.gpg.d ]]
then
mkdir -p "$BKUP/apt-keyrings"
cp -rp /etc/apt/trusted.gpg.d/* "$BKUP/apt-keyrings/" 2>/dev/null || true
echo "Copied apt-keyrings" && echo "Copied apt-keyrings" >> $BKUP_FILE
else echo -e "${Error}ERROR: APT trusted.gpg.d Doesn't exist ${Off}"
fi

if [[ -d /usr/share/keyrings ]]
then
mkdir -p "$BKUP/user-keyrings"
cp -rp /usr/share/keyrings/* "$BKUP/user-keyrings/" 2>/dev/null || true
echo "Copied user-keyrings" && echo "Copied user-keyrings" >> $BKUP_FILE
else echo -e "${Error}ERROR: APT usr/share/keyrings Doesn't exist ${Off}"
fi


###################
##  BACKUP MOTD  ##
###################
mkdir "$BKUP/MOTD"
if [[ -f /etc/motd ]]
then cp /etc/motd "$BKUP/MOTD/"
echo "Copied MOTD" && echo "Copied MOTD" >> $BKUP_FILE
else :
fi
if [[ -d /etc/update-motd.d ]]
then cp -rp /etc/update-motd.d/* "$BKUP/MOTD/"
echo "Copied MOTD scripts" && echo "Copied MOTD scripts" >> $BKUP_FILE
else :
fi


####################
##  BACKUP USERS  ##
####################
mkdir "$BKUP/USERS"
if [[ -f /etc/passwd ]]
then cp -p /etc/passwd "$BKUP/USERS/"
echo "Copied users in passwd" && echo "Copied users in passwd" >> $BKUP_FILE
fi


#############
##  SAMBA  ##
#############
if [[ -f /etc/samba/smb.conf ]]
then cp -p /etc/samba/smb.conf "$BKUP/USERS/"
echo "Copied smb.conf" && echo "Copied smb.conf" >> $BKUP_FILE
fi


#######################
##  SYSTEM SERVICES  ##
#######################
if [[ -d /etc/systemd/system ]]
then mkdir "$BKUP/SERVICES"
cp -rp /etc/systemd/system/* "$BKUP/SERVICES/"
echo "Copied systemd services" && echo "Copied systemd services" >> $BKUP_FILE
else echo -e "${Error}ERROR: Systemd/Services Doesn't exist ${Off}"
fi


###########
##  SSH  ##
###########
if [[ -f /etc/ssh/sshd_config ]]
then mkdir "$BKUP/SSH"
cp -rp /etc/ssh/ssh_config /etc/ssh/sshd_config "$BKUP/SSH/"
echo "Copied sshd_config" && echo "Copied sshd_config" >> $BKUP_FILE
else echo -e "${Error}ERROR: sshd Doesn't exist ${Off}"
fi
if [[ -d /etc/ssh/sshd_config.d ]]
then
cp -rp /etc/ssh/sshd_config.d "$BKUP/SSH/"
cp -rp /etc/ssh/ssh_config.d "$BKUP/SSH/"
echo "Copied sshd_config.d folder" && echo "Copied sshd_config.d" >> $BKUP_FILE
fi


####################
##  APACHE/NGINX  ##
####################
mkdir -p "$BKUP/SERVERS"
if [[ -d /etc/apache2 ]]
then
cp -rp /etc/apache2 "$BKUP/SERVERS"
echo "Copied apache" && echo "Copied apache" >> $BKUP_FILE
fi
if [[ -d /etc/nginx ]]
then
cp -rp /etc/nginx "$BKUP/SERVERS"
echo "Copied nginx" && echo "Copied nginx" >> $BKUP_FILE
fi


###########
##  SSL  ##
###########
if [[ -d /etc/ssl/private ]]
then mkdir -p "$BKUP/SERVERS/SSL"
cp -rp /etc/ssl/private "$BKUP/SERVERS/SSL/"
echo "Copied private ssl files" && echo "Copied private ssl files" >> $BKUP_FILE
else :
fi
if [[ -f /etc/ssl/openssl.cnf ]]
then
cp -rp /etc/ssl/openssl.cnf "$BKUP/SERVERS/SSL/"
echo "Copied openssl.cnf" && echo "Copied openssl.cnf" >> $BKUP_FILE
else :
fi


#################
##  WEB FILES  ##
#################
if [[ -d /var/www/html ]]
then mkdir -p "$BKUP/SERVERS/WEB-FILES"
cp -rp /var/www/html/* "$BKUP/SERVERS/WEB-FILES/"
echo "Copied www files" && echo "Copied www files" >> $BKUP_FILE
else :
fi


###################
##  MODSECURITY  ##
###################
if [[ -d /etc/modsecurity ]]
then mkdir -p "$BKUP/SERVERS/MODSECURITY"
cp -rp /etc/modsecurity "$BKUP/SERVERS/MODSECURITY"
echo "Copied modsecurity" && echo "Copied modsecurity" >> $BKUP_FILE
else :
fi


################
##  FAIL2BAN  ##
################
if [[ -d /etc/fail2ban ]]
then mkdir -p "$BKUP/FAIL2BAN"
cp -rp /etc/fail2ban "$BKUP/FAIL2BAN"
echo "Copied fail2ban" && echo "Copied fail2ban" >> $BKUP_FILE
else :
fi


#####################
##  ETC/SUDOERS.D  ##
#####################
if [[ -d /etc/sudoers.d ]]
then mkdir -p "$BKUP/SUDOERS.D"
cp -rp /etc/sudoers.d "$BKUP/SUDOERS.D"
echo "Copied sudoers.d" && echo "Copied sudoers.d" >> $BKUP_FILE
else :
fi


#############
##  FILES  ##
#############

# /etc/nftables.conf
# /etc/msmtprc
# /etc/sudoers

FILES=(
  "/etc/nftables.conf"
  "/etc/msmtprc"
  "/etc/sudoers"
)

echo "" && echo "" >> $BKUP_FILE
echo "Specific Files:" >> $BKUP_FILE

mkdir -p "$BKUP/FILES"
FILESDIR="$BKUP/FILES"
for file in "${FILES[@]}"
do
  if [ -f "$file" ]
  then
  cp "$file" "$FILESDIR/"
  echo "  [SUCCESS] Copied: $file" && echo "Copied: $file" >> $BKUP_FILE
  else echo "  [WARNING] File not found or not a regular file: '$file' (skipping)" >&2
  fi
done

echo "" && echo "" >> $BKUP_FILE

###########
##  NUT  ##
###########
if [[ -d /etc/nut ]]
then
mkdir -p "$BKUP/NUT"
cp -rp /etc/nut "$BKUP/NUT"
echo "Copied nut" && echo "Copied nut" >> $BKUP_FILE
fi


########################
##  HOME DIRECTORIES  ##
########################
if [[ -d /home ]]
then
mkdir "$BKUP/HOMES"
echo "Copying home directories..." && echo "Copying home directories" >> $BKUP_FILE
rsync -aAXHv \
--exclude='**/.cache/' \
--exclude='**/cache/' \
--exclude='**/go/pkg/' \
--exclude='**/whisper/venv/' \
--info=progress2 "/home/" "$BKUP/HOMES/"
else
echo -e "${Error}ERROR: home directory Doesn't exist ${Off}"
fi


if [[ "${REMOVE_RSYNC:-0}" -eq 1 ]]
then echo "Removing rsync" && echo "Removing RSYNC" >> $BKUP_FILE
apt remove rsync -y 
fi
echo -e "\nComplete." >> $BKUP_FILE


###########
##  ZIP  ##
###########
echo "Installing zip package"
apt install zip -y
echo -e "\ncompressing bkup\n"
(cd $BKUP && zip -r $ZIP_FILE .)


################
##  COMPLETE  ##
################
rm -r $BKUP_TEMP
echo -e "\nComplete."
echo -e "Check\n $ZIP_FILE \nFor backup file"
exit 0
