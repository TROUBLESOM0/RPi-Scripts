#!/bin/bash
#
# Creates backup of Debian system
#  Specifically on Raspberry Pi's running Raspberry Pi OS(Raspbian)

# Fail instantly
set -euo pipefail

### VARIABLES
Error='\033[1;31m'   # Bold red
Off='\033[0m'
USER=${SUDO_USER:-$USER}
THIS_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)
HOSTNAME=$(hostname)
HOSTIP=$(hostname -I)
RELEASE=$(uname -r)
OS_BIT=$(uname -m)
OS_BIT_NUMBER=""
OS_NAME=$(cat /etc/os-release | grep VERSION_CODENAME | cut -d '=' -f2 | tr '[:lower:]' '[:upper:]')
MACHINE_BUILD=""
RAM_USAGE=$(free -h)
MANUAL_INSTALL_LIST=$(apt-mark showmanual | pr -t -3)
COMPLETE_INSTALL_LIST=$(dpkg-query -W -f='${Status}\t${Package}\t${Version}\t${binary:Summary}\n' | grep '^install ok installed' | cut -f2- | column -t -s $'\t')

DATE=$(date +"%m-%d-%Y")
BKUP_TEMP="/usr/temp"
BKUP="$BKUP_TEMP/${HOSTNAME}_${OS_NAME}-Bkup_${DATE}"
BKUP_FILE="$BKUP/contents.txt"
ZIP_FILE="$THIS_DIR/${HOSTNAME}_${OS_NAME}-Bkup_${DATE}.zip"

if [[ -f /proc/device-tree/model ]]; then
MACHINE_BUILD=$(tr -d '\0' < /proc/device-tree/model)
else MACHINE_BUILD=""
fi



##################
## BEGIN SCRIPT ##
##################
# Check script is running as root
if [[ $( whoami ) != "root" ]]
then echo -e "${Error}ERROR: Must be run as sudo or root ${Off}"
exit 1
fi

echo "User: $USER"
echo "Current Directory: $THIS_DIR"

# Determine 32 or 64 bit
if [[ $OS_BIT == "armv7l" || "armhf" ]]
then echo "32bit-OS"
OS_BIT_NUMBER="32bit"
else echo "64bit-OS"
OS_BIT_NUMBER="64bit"
fi

read -r -p "Do you want to create a backup?" input
if [[ "${input,,}" == "y" || "${input,,}" == "yes" ]]
then :
else exit 1
fi

##########################
##  CREATE BACKUP FILE ###
##########################
if [[ -d $BKUP_TEMP ]]
then rm -r $BKUP_TEMP
fi
mkdir -p $BKUP_TEMP
mkdir -p $BKUP
touch $BKUP_FILE
if [[ -f $BKUP_FILE ]]
then :
else echo -e "${Error}ERROR: Unable to create backup file: $BKUP_FILE ${Off}"
exit 1
fi

echo "Backup file created: $BKUP_FILE"
echo -e "\nCreating backup for:"
echo "- $HOSTNAME  $HOSTIP - $MACHINE_BUILD , $OS_BIT_NUMBER , $RELEASE"

{
echo "Hostname: $HOSTNAME"
echo "Ip Address: $HOSTIP"
echo "$OS_BIT" + "$RELEASE"
echo "$MACHINE_BUILD"
echo "$OS_BIT_NUMBER"
echo -e "\n\n--- RAM USAGE ---"
echo "$RAM_USAGE"
echo -e "\n\n"
} >> $BKUP_FILE

echo "++++++++++++++++" >> $BKUP_FILE
echo "+   EXCLUDED   +" >> $BKUP_FILE
echo "++++++++++++++++" >> $BKUP_FILE
{
echo "- From Home Directory -"
echo "   -/.cache"
echo "   -/cache"
echo "   -/go/pkg"
echo "   -/whisper/venv"
} >> $BKUP_FILE


######################
##  BACKUP CRONJOBS ##
######################
mkdir -p "$BKUP/CRONJOBS"
echo -e "\nListing installed packages..."
{
echo -e "\n\n--- LIST OF MANUALLY INSTALLED PACKAGES ---"
echo        "-------------------------------------------"
echo "$MANUAL_INSTALL_LIST"
} >> $BKUP_FILE

echo $MANUAL_INSTALL_LIST > "$BKUP/MANUAL-APT-LIST.txt"
echo $COMPLETE_INSTALL_LIST > "$BKUP/FULL-APT-LIST.txt"

echo -e "\nCopying cronjobs..."
echo -e "\n\nCRON JOBS" >> $BKUP_FILE
echo "$USER - Cron List:" >> $BKUP_FILE
echo crontab -u pi -l >> $BKUP_FILE
echo -e "\nSUDO - Cron List:" >> $BKUP_FILE
echo crontab -l >> $BKUP_FILE
cp -rp "/etc/cron.d" "$BKUP/CRONJOBS" 2>/dev/null || true
cp -rp "/etc/cron.hourly" "$BKUP/CRONJOBS" 2>/dev/null || true
cp -rp "/etc/cron.daily" "$BKUP/CRONJOBS" 2>/dev/null || true
cp -rp "/etc/cron.weekly" "$BKUP/CRONJOBS" 2>/dev/null || true
cp -rp "/etc/cron.monthly" "$BKUP/CRONJOBS" 2>/dev/null || true
cp -rp "/etc/cron.yearly" "$BKUP/CRONJOBS" 2>/dev/null || true


##################
##  BACKUP APT  ##
##################
if [[ -f /etc/apt/sources.list ]]
then
cp -rp /etc/apt/sources.list /etc/apt/sources.list.d "$BKUP/apt/" 2>/dev/null || true
echo "Copied apt sources"
else echo -e "${Error}ERROR: APT Sources Doesn't exist ${Off}"
fi

if [[ -d /etc/apt/trusted.gpg.d ]]
then
mkdir -p "$BKUP/apt-keyrings"
cp -rp /etc/apt/trusted.gpg.d/* "$BKUP/apt-keyrings/" 2>/dev/null || true
else echo -e "${Error}ERROR: APT trusted.gpg.d Doesn't exist ${Off}"
fi

if [[ -d /usr/share/keyrings ]]
then
mkdir -p "$BKUP/user-keyrings"
cp -rp /usr/share/keyrings/* "$BKUP/user-keyrings/" 2>/dev/null || true
else echo -e "${Error}ERROR: APT usr/share/keyrings Doesn't exist ${Off}"
fi


###################
##  BACKUP MOTD  ##
###################
mkdir "$BKUP/MOTD"
if [[ -f /etc/motd ]]
then cp /etc/motd "$BKUP/MOTD/"
echo "Copied MOTD"
else "motd file not found"
fi
if [[ -d /etc/update-motd.d ]]
then cp -rp /etc/update-motd.d/* "$BKUP/MOTD/"
echo "Copied MOTD scripts"
else "update-motd not found"
fi


####################
##  BACKUP USERS  ##
####################
mkdir "$BKUP/USERS"
if [[ -f /etc/passwd ]]
then cp -p /etc/passwd "$BKUP/USERS/"
echo "copied users"
fi


#############
##  SAMBA  ##
#############
if [[ -f /etc/samba/smb.conf ]]
then cp -p /etc/samba/smb.conf "$BKUP/USERS/"
fi


#######################
##  SYSTEM SERVICES  ##
#######################
if [[ -d /etc/systemd/system ]]
then mkdir "$BKUP/SERVICES"
cp -rp /etc/systemd/system/* "$BKUP/SERVICES/"
echo "Copied systemd services"
else echo -e "${Error}ERROR: Systemd/Services Doesn't exist ${Off}"
fi


###########
##  SSH  ##
###########
if [[ -f /etc/ssh/sshd_config ]]
then mkdir "$BKUP/SSH"
cp -rp /etc/ssh/ssh_config /etc/ssh/sshd_config "$BKUP/SSH/"
echo "Copied sshd_config"
else -e "${Error}ERROR: sshd Doesn't exist ${Off}"
fi
if [[ -d /etc/ssh/sshd_config.d ]]
then
cp -rp /etc/ssh/sshd_config.d "$BKUP/SSH/"
cp -rp /etc/ssh/ssh_config.d "$BKUP/SSH/"
fi


####################
##  APACHE/NGINX  ##
####################
mkdir -p "$BKUP/SERVERS"
if [[ -d /etc/apache2 ]]
then
cp -rp /etc/apache2 "$BKUP/SERVERS"
echo "Copied apache"
fi
if [[ -d /etc/nginx ]]
then
cp -rp /etc/nginx "$BKUP/SERVERS"
echo "Copied nginx"
fi


#################
##  WEB FILES  ##
#################
if [[ -d /var/www/html ]]
then mkdir -p "$BKUP/SERVERS/WEB-FILES"
cp -rp /var/www/html/* "$BKUP/SERVERS/WEB-FILES/"
echo "Copied www files"
else :
fi


###################
##  MODSECURITY  ##
###################
if [[ -d /etc/modsecurity ]]
then mkdir -p "$BKUP/SERVERS/MODSECURITY"
cp -rp /etc/modsecurity "$BKUP/SERVERS/MODSECURITY"
echo "Copied modsecurity"
else :
fi


#####################
##  ETC/SUDOERS.D  ##
#####################
if [[ -d /etc/sudoers.d ]]
then mkdir -p "$BKUP/SUDOERS.D"
cp -rp /etc/sudoers.d "$BKUP/SUDOERS.D"
echo "Copied sudoers.d"
else :
fi


#############
##  FILES  ##
#############

# /etc/nftables.conf
# /etc/msmtprc
# /etc/sudoers

FILES=(
  "/etc/nftables.conf"
  "/etc/msmtprc"
  "/etc/sudoers"
)

mkdir -p "$BKUP/FILES"
FILESDIR="$BKUP/FILES"
for file in "${FILES[@]}"
do
  if [ -f "$file" ]
  then
  cp "$file" "$DEST_DIR/"
  echo "  [SUCCESS] Copied: $file"
  else echo "  [WARNING] File not found or not a regular file: '$file' (skipping)" >&2
  fi
done


###########
##  NUT  ##
###########
if [[ -d /etc/nut ]]
then
mkdir -p "$BKUP/NUT"
cp -rp /etc/nut "$BKUP/NUT"
fi


########################
##  HOME DIRECTORIES  ##
########################
if [[ -d /home ]]
then
mkdir "$BKUP/HOMES"
echo "Copying home directories..."
rsync -aAXHv \
--exclude='**/.cache/' \
--exclude='**/cache/' \
--exclude='**/go/pkg/' \
--exclude='**/whisper/venv/' \
--info=progress2 "/home/" "$BKUP/HOMES/"
else
echo -e "${Error}ERROR: home directory Doesn't exist ${Off}"
fi


###########
##  ZIP  ##
###########
echo "Installing zip package"
apt install zip -y
echo -e "\ncompressing bkup\n"
zip -r $ZIP_FILE $BKUP


################
##  COMPLETE  ##
################
rm -r $BKUP
echo -e "\nComplete."
echo -e "Check\n $BKUP_FILE \nFor backup file"
exit 0
